---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
  <section class="min-h-screen flex items-center justify-center text-center px-6">
    <div>
      <h1 class="heading-lg mb-4">Авторизация</h1>
      <p class="text-monolith-text-secondary mb-6" id="auth-status">Обрабатываю приглашение...</p>
    </div>
  </section>
</MainLayout>

<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.init({
      APIUrl: "https://timely-pavlova-cd7b47.netlify.app/.netlify/identity"
    });
    window.netlifyIdentity.on("init", user => {
      if (user) {
        document.getElementById('auth-status').textContent = 'Успешно! Перехожу в админку...';
        setTimeout(() => { document.location.href = '/admin/'; }, 1000);
      } else {
        document.getElementById('auth-status').textContent = 'Проверяю токен...';
      }
    });
  } else {
    document.getElementById('auth-status').textContent = 'Виджет не загрузился. Обновите страницу.';
  }
</script>